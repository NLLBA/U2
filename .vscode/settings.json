{
    "files.exclude": {
        "**/.DS_Store": true,
        "**/Thumbs.db": true,
        "**/desktop.ini": true,
        "**/.git": true,
        "**/.gitmodules": true,
        "**/.svn": true,
        "**/.hg": true,
        "Library/": true,
        "Temp/": true,
        "Build/": true,
        "build/": true,
        "Obj/": true,
        "obj/": true,
        "ProjectSettings/": true,
        "**/*.userprefs": true,
        "**/*.suo": true,
        "**/*.user": true,
        "**/*.unityproj": true,
        "**/*.booproj": true,
        "**/*.pidb": true,
        "**/*.meta": true,
        "**/*.asset": true,
        "**/*.cubemap": true,
        "**/*.flare": true,
        "**/*.mat": true,
        "**/*.prefab": true,
        "**/*.unity": true,
        "**/*.dll": false,
        "**/*.exe": false,
        "**/*.pdf": false,
        "**/*.wav": false,
        "**/*.mid": false,
        "**/*.midi": false,
        "**/*.gif": false,
        "**/*.ico": false,
        "**/*.jpg": false,
        "**/*.jpeg": false,
        "**/*.png": false,
        "**/*.psd": false,
        "**/*.tga": false,
        "**/*.tif": false,
        "**/*.tiff": false,
        "**/*.3ds": false,
        "**/*.3DS": false,
        "**/*.fbx": false,
        "**/*.FBX": false,
        "**/*.lxo": false,
        "**/*.LXO": false,
        "**/*.ma": false,
        "**/*.MA": false,
        "**/*.obj": false,
        "**/*.OBJ": false
    },
    "search.exclude": {
        "**/Library": true,
        "**/Temp": true,
        "**/Build": true,
        "**/xlua_gen": true,
        "**/XLua/Examples/**": true,
        "**/*.meta": true
    },
    "files.watcherExclude": {
        "**/.git/objects/**": true,
        "**/.git/subtree-cache/**": true,
        "**/Library/**": true,
        "**/Temp/**": true,
        "**/Build/**": true,
        "**/xlua_gen/**": true,
        "**/XLua/Examples/**": true
    },
    "dotnet.defaultSolution": "U2.sln",
    "Lua.runtime.version": "Lua 5.3",
    "Lua.runtime.special": {
        "require": "require",
        "import": "import"
    },
    "Lua.diagnostics.disable": [
        "unused"
    ],
    "Lua.diagnostics.enable": true,
    "Lua.diagnostics.globals": [
        "CS",
        "UnityEngine",
        "xlua",
        "print",
        "require",
        "import",
        "tofunction"
    ],
    "Lua.diagnostics.severity": {
        "undefined-global": "Warning",
        "undefined-field": "Information",
        "redefined": "Warning"
    },
    "Lua.workspace.checkThirdParty": false,
    "Lua.workspace.userThirdParty": [],
    "Lua.workspace.library": [
        "${workspace}/Assets",
        "${workspace}/Assets/XLua",
        "${workspace}/Assets/XLua/Src"
    ],
    "Lua.workspace.ignoreDir": [
        "**/XLua/Examples/**",
        "**/xlua_gen/**",
        "**/Plugins/**",
        "**/StreamingAssets/**"
    ],
    "Lua.workspace.maxPreload": 5000,
    "Lua.workspace.preloadFileSize": 500,
    "Lua.workspace.useGitIgnore": true,
    "Lua.completion.enable": true,
    "Lua.completion.showWord": "Fallback",
    "Lua.completion.autoRequire": false,
    "Lua.completion.keywordSuggestion": "Fallback",
    "Lua.completion.requireSeparator": "/",
    "Lua.debug.enable": true,
    "Lua.debug.port": 7003,
    "files.encoding": "utf8",
    "files.autoGuessEncoding": true,
    "files.eol": "\n",
    "files.associations": {
        "*.lua.txt": "lua"
    }
}